# Core secrets: generate once and keep unchanged after first deployment.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
WINDSIGHT_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

# Storage
DATABASE_URL=sqlite:////var/lib/wanwu-shuju/wanwu-shuju.db
LOG_FILE=/var/log/wanwu-shuju/wanwu-shuju.log
LOG_LEVEL=INFO

# HTTP / realtime
PORT=8088
FORCE_ASYNC_MODE=eventlet
ALLOWED_ORIGINS=https://DOMAIN
WINDSIGHT_TEMPLATE_AUTO_RELOAD=0

# Bootstrap account. Save the real password only in this server-side file.
WINDSIGHT_DEFAULT_ADMIN_ENABLED=1
WINDSIGHT_DEFAULT_ADMIN_USERNAME=admin
WINDSIGHT_DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Behaviour
NODE_TIMEOUT_SECONDS=90
DATA_RETENTION_DAYS=30
