# Keep this file outside the repository after replacing the values below.
# Generate a stable Secret Key once, for example:
#   python3.11 -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# Generate a stable Fernet key once:
#   python3.11 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WINDSIGHT_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

# Storage and logs
DATABASE_URL=sqlite:////var/lib/wind-turbine-demo/wind_turbine_demo.db
LOG_FILE=/var/log/wind-turbine-demo/windsight.log
LOG_LEVEL=INFO

# HTTP / realtime: Nginx is the only public entry point.
PORT=8081
FORCE_ASYNC_MODE=eventlet
ALLOWED_ORIGINS=http://DOMAIN
WINDSIGHT_TEMPLATE_AUTO_RELOAD=0
SESSION_COOKIE_NAME=wind_turbine_demo_session
REMEMBER_COOKIE_NAME=wind_turbine_demo_remember

# Bootstrap account. Keep the real password only in this server-side file.
WINDSIGHT_DEFAULT_ADMIN_ENABLED=1
WINDSIGHT_DEFAULT_ADMIN_USERNAME=admin
# WINDSIGHT_DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Behaviour
NODE_TIMEOUT_SECONDS=90
DATA_RETENTION_DAYS=30
WINDSIGHT_ALLOW_LEGACY_NODE_KEY_UPLOAD=1
