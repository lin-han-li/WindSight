# WindSight 环境变量配置模板（推荐复制为 windsight.env）
# 说明：
# - app.py 启动时会按优先级加载：WINDSIGHT_ENV_FILE > windsight.env > .env
# - windsight.env 属于本机私有配置文件，请勿提交到仓库

# ==================== 安全配置 ====================
SECRET_KEY=请替换为固定的高熵随机字符串
# HMAC 节点凭证的 secret 需要可恢复加密保存；生产环境请使用固定 Fernet key。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WINDSIGHT_CREDENTIAL_ENCRYPTION_KEY=请填入固定Fernet密钥
SESSION_COOKIE_NAME=wind_turbine_demo_session
REMEMBER_COOKIE_NAME=wind_turbine_demo_remember

# ==================== 默认管理员（首次启动自动创建）====================
# 未设置 WINDSIGHT_DEFAULT_ADMIN_PASSWORD 时，后端会生成随机密码并打印到日志
WINDSIGHT_DEFAULT_ADMIN_ENABLED=1
WINDSIGHT_DEFAULT_ADMIN_USERNAME=admin
# WINDSIGHT_DEFAULT_ADMIN_PASSWORD=请设置强密码

# ==================== 普通用户注册 ====================
# 普通用户注册由管理员在“系统设置 -> 邀请注册”中生成一次性邀请码。
# 旧版 WINDSIGHT_USER_INVITE_CODE 共享邀请码已废弃，不再作为注册通行码使用。

# ==================== 数据库配置 ====================
# 目录结构约定（根目录只保留 code/ 与 database/）：默认指向 ../database/wind_farm.db
DATABASE_URL=sqlite:///../database/wind_turbine_demo.db

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8080

# ==================== 跨域配置 ====================
ALLOWED_ORIGINS=*

# ==================== 高德地图配置 ====================
# 申请 Web 端 JS API Key 后填写；不配置时前端自动使用拓扑图兜底
AMAP_JS_KEY=
# 本地联调可填 securityJsCode；生产环境优先使用下方安全代理
AMAP_SECURITY_CODE=
# 生产环境建议在 Nginx/后端配置安全代理，例如 /_AMapService/
AMAP_SECURITY_SERVICE_HOST=
# 可选：未能从节点坐标计算中心点时使用
AMAP_DEFAULT_CENTER_LNG=
AMAP_DEFAULT_CENTER_LAT=
AMAP_DEFAULT_ZOOM=10

# ==================== 数据保留配置 ====================
DATA_RETENTION_DAYS=30

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/windsight.log

# ==================== 性能/超时配置 ====================
SOCKET_PING_INTERVAL=10
SOCKET_PING_TIMEOUT=20
DB_TIMEOUT=20

# 节点在线超时时间（秒）：超过该时间未上传数据即判定为离线
NODE_TIMEOUT_SECONDS=90
