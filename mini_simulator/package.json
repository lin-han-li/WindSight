{
  "name": "windsight-mini-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "WindSight manual upload simulator desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "build:server": "node scripts/build-server-binary.mjs win32 x64",
    "desktop:dev": "npm run build:server && electron .",
    "dist:win": "npm run build:server && node scripts/build-desktop.mjs win x64",
    "dist:dir": "npm run build:server && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.windsight.mini.simulator",
    "productName": "WindSight Manual Simulator",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/server",
        "to": "server",
        "filter": [
          "windsight-mini-simulator-backend.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WindSight Manual Simulator",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
